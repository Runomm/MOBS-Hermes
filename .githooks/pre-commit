#!/bin/sh
# Hermes secret guardrail — staged değişikliklerde sır (özellikle HuggingFace
# token'ı) varsa commit'i ENGELLE. HF token asla repo'ya / GitHub'a girmemeli;
# release'te de app içinde kalmamalı (bkz. RELEASE_CHECKLIST.md).
#
# Aktif olması için (bir kez): git config core.hooksPath .githooks
#
# Gerçekten gerekiyorsa atlamak için: git commit --no-verify  (dikkatli kullan)

staged=$(git diff --cached -U0)

block() {
  echo ""
  echo "✖ COMMIT ENGELLENDİ — staged değişikliklerde sır tespit edildi:"
  echo "  $1"
  echo ""
  echo "  Hermes kuralı: HF token / API anahtarı asla repo'ya girmez."
  echo "  Token runtime'da (uygulama içi alan) girilir, koda gömülmez."
  echo "  Yanlış alarm olduğundan eminsen:  git commit --no-verify"
  echo ""
  exit 1
}

# HuggingFace token: hf_ + 30+ alfanümerik
if printf '%s' "$staged" | grep -nE 'hf_[A-Za-z0-9]{30,}' >/dev/null 2>&1; then
  block "HuggingFace token kalıbı (hf_...) bulundu."
fi

# Genel: yüksek-entropili anahtarlar için yaygın isimler atanmışsa uyar
if printf '%s' "$staged" | grep -nE '(api[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_\-]{16,}' >/dev/null 2>&1; then
  block "Gömülü gizli anahtar/şifre kalıbı bulundu (api_key/secret/token/password = \"...\")."
fi

exit 0
