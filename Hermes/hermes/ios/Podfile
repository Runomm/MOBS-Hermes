# Hermes iOS Podfile.
# Minimum iOS 16.0 — flutter_gemma ve flutter_onnxruntime 16.0, whisper_ggml
# 15.6, google_mlkit_* 15.5 ister. En yüksek olan 16.0 tüm projeye uygulanır.
# (iPhone 17 Pro Max iOS 26 çalıştırır, 16.0 minimum tamamen güvenli.)
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # :static — flutter_gemma (MediaPipeTasksGenAI) + ML Kit/whisper
  # (TensorFlowLiteC) statik xcframework getiriyor; düz use_frameworks! ile
  # "transitive dependencies that include statically linked binaries" hatası
  # verir. Statik linkage bunu çözer.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# ML Kit pod'ları (çeviri + OCR + dil tespiti) DİNAMİK framework + resource
# `.bundle` (model/sözlük dosyaları) ister; `use_frameworks! :linkage => :static`
# altında bu bundle'lar app'e kopyalanmıyor/çözülemiyor → iOS'te
# `translateText` Error 13 "model file not found" / OCR boş döner (hem
# google_mlkit_translation hem _text_recognition hem _language_id). Çözüm:
# yalnız ML Kit ailesi pod'larını dinamik framework'e zorla; flutter_gemma
# (MediaPipeTasksGenAI) ve whisper (TensorFlowLiteC) statik kalmaya devam eder
# (onlar statik xcframework şart). pre_install, pod entegrasyonundan ÖNCE her
# pod'un `build_type`'ını override eder.
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('GoogleMLKit') ||
        pod.name.start_with?('MLKit') ||
        pod.name.start_with?('MLImage') ||
        pod.name == 'GoogleToolboxForMac' ||
        pod.name == 'GoogleUtilities' ||
        pod.name == 'GoogleUtilitiesComponents' ||
        pod.name == 'GTMSessionFetcher' ||
        pod.name == 'PromisesObjC' ||
        pod.name == 'Protobuf'
      def pod.build_type
        Pod::BuildType.dynamic_framework
      end
    end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Tüm pod'ları 16.0'a sabitle (bazı pod'lar daha düşük varsayar).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

      # permission_handler iOS makroları — KRİTİK. permission_handler_apple
      # her izni `#if PERMISSION_X` ile derler ve `PermissionHandlerEnums.h`
      # makro tanımsızsa onu **0**'a düşürür → izin kodu derlemeye HİÇ girmez →
      # `Permission.microphone.request()` izin penceresini AÇMADAN "reddedildi"
      # döner (SmallTalk/Konferans'ta "mikrofon izni reddedildi ama izin istemedi
      # bile" bunun sonucuydu). Kullandığımız izinleri açıkça =1 yapıyoruz.
      # ||= değil: flutter_additional_ios_build_settings bu anahtarı zaten
      # tanımlamış olabilir → ||= atlanır ve makrolar uygulanmaz. Mevcut değere
      # ekleyerek garantile.
      existing = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      existing = [existing] if existing.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing + [
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
      ]
    end
  end
end
